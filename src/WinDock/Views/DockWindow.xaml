<Window x:Class="WinDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:v="clr-namespace:WinDock.Views"
        xmlns:vm="clr-namespace:WinDock.ViewModels"
        Title="WinDock Dock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        Width="900" Height="170" Left="-32000" Top="-32000" AllowDrop="True" Focusable="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource DockFont}">

    <Window.Resources>
        <sys:Double x:Key="IconSize">46</sys:Double>
        <sys:Double x:Key="WideSize">100</sys:Double>
        <sys:Double x:Key="WiderSize">154</sys:Double>
        <SolidColorBrush x:Key="DockLine" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="DotIdle" Color="#59FFFFFF"/>
        <SolidColorBrush x:Key="TileFace" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="DockInk" Color="#F4EFE7"/>
        <SolidColorBrush x:Key="DockMuted" Color="#B3F4EFE7"/>
        <FontFamily x:Key="Glyphs">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <LinearGradientBrush x:Key="WClock" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F8CFF" Offset="0"/>
            <GradientStop Color="#2F5FE0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WPomodoro" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6F5B" Offset="0"/>
            <GradientStop Color="#E0453A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WBreak" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#0E9F6E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WStopwatch" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB547" Offset="0"/>
            <GradientStop Color="#E8890C" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WTimer" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A07CFF" Offset="0"/>
            <GradientStop Color="#7044F0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WCountdown" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3DDC97" Offset="0"/>
            <GradientStop Color="#13A86B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WProgress" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#22C3E6" Offset="0"/>
            <GradientStop Color="#0A8FB8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WActivity" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8A3D" Offset="0"/>
            <GradientStop Color="#E3601A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WBattery" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5BD46B" Offset="0"/>
            <GradientStop Color="#2EA043" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WMusic" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D2F3A" Offset="0"/>
            <GradientStop Color="#17181F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WWeather" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#56B8FF" Offset="0"/>
            <GradientStop Color="#2B7FE6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WWeatherNight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3D4C8F" Offset="0"/>
            <GradientStop Color="#1A2152" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WNetwork" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5B6CFF" Offset="0"/>
            <GradientStop Color="#3A43D6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WNote" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE58A" Offset="0"/>
            <GradientStop Color="#F6C945" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WTodo" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3CC98F" Offset="0"/>
            <GradientStop Color="#1E8E62" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WClaude" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E58A68" Offset="0"/>
            <GradientStop Color="#C4603E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WClaudeHot" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F05A48" Offset="0"/>
            <GradientStop Color="#B8261B" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WindowsBlue" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7FD3FF" Offset="0"/>
            <GradientStop Color="#1E88E5" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="WInk" Color="White"/>
        <SolidColorBrush x:Key="WSoft" Color="#E0FFFFFF"/>
        <SolidColorBrush x:Key="WTrack" Color="#40FFFFFF"/>

        <Style x:Key="TileRoot" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="{DynamicResource IconSize}"/>
            <EventSetter Event="MouseEnter" Handler="OnTileEnter"/>
            <EventSetter Event="MouseLeave" Handler="OnTileLeave"/>
            <EventSetter Event="MouseDown" Handler="OnTileDown"/>
            <EventSetter Event="MouseUp" Handler="OnTileUp"/>
            <EventSetter Event="MouseWheel" Handler="OnTileWheel"/>
            <EventSetter Event="Loaded" Handler="OnTileLoaded"/>
        </Style>

        <Style x:Key="SystemSpot" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TileFace}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact widgets: a square tile with one value, an optional ring, glyph or picture. -->
        <DataTemplate x:Key="CompactWidget">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Face.Tip}">
                <Border x:Name="Plate" CornerRadius="13" Background="{DynamicResource TileFace}"/>
                <Border CornerRadius="13" Visibility="{Binding Face.HasImage, Converter={StaticResource Show}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Face.Image}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <Ellipse Margin="4" Stroke="{DynamicResource DockLine}" StrokeThickness="2.4" Visibility="{Binding Face.HasRing, Converter={StaticResource Show}}"/>
                <v:RingArc x:Name="Outer" Margin="4" Progress="{Binding Face.Ring}" Stroke="{DynamicResource DockInk}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           Visibility="{Binding Face.HasRing, Converter={StaticResource Show}}"/>
                <Ellipse Margin="10" Stroke="{DynamicResource DockLine}" StrokeThickness="2.4" Visibility="{Binding Face.HasInnerRing, Converter={StaticResource Show}}"/>
                <v:RingArc Margin="10" Progress="{Binding Face.InnerRing}" Stroke="{Binding Face.InnerTint}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                           Visibility="{Binding Face.HasInnerRing, Converter={StaticResource Show}}"/>
                <Border CornerRadius="13" Background="{StaticResource WNote}" Visibility="{Binding Face.HasPaper, Converter={StaticResource Show}}">
                    <TextBlock Text="{Binding Face.Paper}" FontFamily="{StaticResource DockFont}" FontSize="8" FontWeight="SemiBold" Foreground="#3A2E12"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="9.5" LineStackingStrategy="BlockLineHeight"
                               Margin="5,5,4,5" VerticalAlignment="Center"/>
                </Border>
                <Grid VerticalAlignment="Bottom" Height="2.5" Margin="8,0,8,5" Visibility="{Binding Face.HasBar, Converter={StaticResource Show}}">
                    <Border CornerRadius="1.25" Background="#66FFFFFF"/>
                    <Border CornerRadius="1.25" Background="White" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Face.Bar}"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <Viewbox x:Name="Content" Margin="8" StretchDirection="DownOnly">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Face.Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasGlyph, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Symbol}" FontFamily="Segoe UI Symbol" FontSize="14" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasSymbol, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Value}" FontFamily="{StaticResource DockFont}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center"
                                   Visibility="{Binding Face.HasValue, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Face.Caption}" FontFamily="{StaticResource DockFont}" FontSize="8" Foreground="{DynamicResource DockMuted}" HorizontalAlignment="Center"
                                   MaxWidth="44" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Visibility="{Binding Face.HasCaption, Converter={StaticResource Show}}"/>
                    </StackPanel>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Face.HasRing}" Value="True">
                    <Setter TargetName="Content" Property="Margin" Value="10"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Face.Alert}" Value="True">
                    <Setter TargetName="Plate" Property="Background" Value="#E6E5483B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Face.HasTint}" Value="True">
                    <Setter TargetName="Outer" Property="Stroke" Value="{Binding Face.Tint}"/>
                </DataTrigger>
                <!-- Old data (offline, signed out): the value fades, like the wide tiles. -->
                <DataTrigger Binding="{Binding Face.Dim}" Value="True">
                    <Setter TargetName="Content" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Outer" Property="Opacity" Value="0.5"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ClusterSpot" TargetType="Border" BasedOn="{StaticResource SystemSpot}">
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DockFont}"/>
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="Foreground" Value="{StaticResource WSoft}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Big" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DockFont}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource WInk}"/>
        </Style>

        <Style x:Key="WidgetFace" TargetType="Border">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:AppTile}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}">
                <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding HasIcon, Converter={StaticResource Show}}"/>
                <Border CornerRadius="12" Background="{DynamicResource TileFace}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="16"
                               Foreground="{DynamicResource DockInk}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" MinWidth="17" Height="17"
                        CornerRadius="8.5" Background="#FF453A" Padding="4,0" BorderBrush="#40000000" BorderThickness="1"
                        Visibility="{Binding HasBadge, Converter={StaticResource Show}}">
                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SeparatorTile}">
            <Grid Width="11" Height="{DynamicResource IconSize}">
                <Rectangle Width="1" Margin="0,7" Fill="{DynamicResource DockLine}" HorizontalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StartTile}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}">
                <Border CornerRadius="13" Background="{DynamicResource TileFace}"/>
                <Viewbox Margin="12">
                    <Canvas Width="20" Height="20">
                        <Rectangle Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource WindowsBlue}"/>
                        <Rectangle Canvas.Left="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource WindowsBlue}"/>
                        <Rectangle Canvas.Top="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource WindowsBlue}"/>
                        <Rectangle Canvas.Left="10.6" Canvas.Top="10.6" Width="9.4" Height="9.4" RadiusX="1" RadiusY="1" Fill="{StaticResource WindowsBlue}"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemTile}">
            <StackPanel Orientation="Horizontal" Height="{DynamicResource IconSize}">
                <Border Background="Transparent" Padding="6,0" Cursor="Hand" ToolTip="{Binding TrayTip}" MouseLeftButtonUp="OnTrayClick">
                    <TextBlock Text="&#xE70E;" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center"/>
                </Border>
                <!-- Network, sound, microphone and battery share one pill, like the quick settings button of Windows 11. -->
                <Border CornerRadius="11" Margin="2,8,2,8" Padding="3,0" Background="{DynamicResource TileFace}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource ClusterSpot}" ToolTip="{Binding NetworkTip}" MouseLeftButtonUp="OnStatusClick">
                            <TextBlock Text="{Binding NetworkGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" ToolTip="{Binding VolumeTip}" MouseUp="OnVolumeClick" MouseWheel="OnVolumeWheel">
                            <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" ToolTip="{Binding MicTip}" MouseLeftButtonUp="OnMicClick"
                                Visibility="{Binding HasMic, Converter={StaticResource Show}}">
                            <TextBlock x:Name="MicIcon" Text="{Binding MicGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Style="{StaticResource ClusterSpot}" ToolTip="{Binding BatteryTip}" MouseLeftButtonUp="OnStatusClick"
                                Visibility="{Binding HasBattery, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding BatteryGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="14" Foreground="{DynamicResource DockInk}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SystemSpot}" Padding="8,0,8,0" ToolTip="{Binding ClockTip}" MouseLeftButtonUp="OnClockClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource DockInk}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Date}" FontSize="11.5" Foreground="{DynamicResource DockMuted}" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
                <Border Width="9" Margin="3,7,0,7" Background="Transparent" Cursor="Hand" ToolTip="{Binding DesktopTip}" MouseLeftButtonUp="OnDesktopClick">
                    <Rectangle Width="1" Fill="{DynamicResource DockLine}" HorizontalAlignment="Right"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding MicMuted}" Value="True">
                    <Setter TargetName="MicIcon" Property="Foreground" Value="#FF5A4E"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClockWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WClock}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Display}" FontSize="16.5" Foreground="{StaticResource WInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" FontSize="8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PomodoroWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{StaticResource WPomodoro}">
                        <Grid Margin="9,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="26" Height="26" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource WTrack}" StrokeThickness="3"/>
                                <v:RingArc Progress="{Binding Progress}" Stroke="{StaticResource WInk}" StrokeThickness="3"
                                           StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{Binding Done}" FontFamily="{StaticResource DockFont}" FontWeight="Bold" FontSize="9" Foreground="{StaticResource WInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Big}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBreak}" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource WBreak}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StopwatchWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WStopwatch}">
                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Glyphs}" FontSize="19" Foreground="{StaticResource WInk}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Big}" FontSize="13"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TimerWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WTimer}">
                        <Grid Margin="9,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="26" Height="26" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource WTrack}" StrokeThickness="3"/>
                                <v:RingArc Progress="{Binding Progress}" Stroke="{StaticResource WInk}" StrokeThickness="3"
                                           StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="{StaticResource WInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Big}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- To-do: how many are left and the next one. -->
        <DataTemplate DataType="{x:Type vm:TodoWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WTodo}">
                        <Grid Margin="8,0,7,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" BorderBrush="{StaticResource WInk}" BorderThickness="1.6" VerticalAlignment="Center">
                                <TextBlock x:Name="Left" Text="{Binding Left}" FontFamily="{StaticResource DockFont}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource WInk}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WInk}"/>
                                <TextBlock Text="{Binding Next}" Style="{StaticResource Caption}" FontSize="7.5" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Left}" Value="0">
                    <Setter TargetName="Left" Property="Text" Value="&#x2713;"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CountdownWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WCountdown}">
                        <Grid Margin="8,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Display}" FontSize="16" Foreground="{StaticResource WInk}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Caption}" FontSize="7" LineHeight="8.5" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="27" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProgressWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WProgress}">
                        <Grid Margin="10,7,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Big}" FontSize="15"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Height="4">
                                <Border CornerRadius="2" Background="{StaticResource WTrack}"/>
                                <Border CornerRadius="2" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Value}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ActivityWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WActivity}">
                        <Grid Margin="9,8,9,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="27"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Height="4" Margin="2,0,4,0">
                                <Border CornerRadius="2" Background="{StaticResource WTrack}"/>
                                <Border CornerRadius="2" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Cpu}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding CpuText}" Style="{StaticResource Caption}" Foreground="{StaticResource WInk}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="RAM" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <Grid Grid.Row="1" Grid.Column="1" Height="4" Margin="2,0,4,0">
                                <Border CornerRadius="2" Background="{StaticResource WTrack}"/>
                                <Border CornerRadius="2" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Ram}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamText}" Style="{StaticResource Caption}" Foreground="{StaticResource WInk}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ClaudeWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{StaticResource WClaude}">
                        <Grid Margin="8,7,9,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="17"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="M 6.5,0.8 L 6.5,12.2 M 0.8,6.5 L 12.2,6.5 M 2.5,2.5 L 10.5,10.5 M 10.5,2.5 L 2.5,10.5"
                                  Stroke="{StaticResource WInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="13" Height="13" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="5h" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" Height="4" Margin="1,0,4,0">
                                    <Border CornerRadius="2" Background="{StaticResource WTrack}"/>
                                    <Border CornerRadius="2" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Session}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding SessionText}" Style="{StaticResource Caption}" Foreground="{StaticResource WInk}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="7d" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" Height="4" Margin="1,0,4,0">
                                    <Border CornerRadius="2" Background="{StaticResource WTrack}"/>
                                    <Border CornerRadius="2" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Week}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WeekText}" Style="{StaticResource Caption}" Foreground="{StaticResource WInk}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Hot}" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource WClaudeHot}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Stale}" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Music like PrimoDock: the cover, title and artist with the progress, and every control, over the cover tint. -->
        <DataTemplate x:Key="MusicFull">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WiderSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Width="154" Background="{StaticResource WMusic}">
                        <Grid>
                            <Border CornerRadius="11" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Backdrop}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="11" Background="#99000000"/>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource WTrack}">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{StaticResource WInk}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="7" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WInk}"/>
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" FontSize="7.5" Margin="0,1,0,0"/>
                                    <Grid Height="2" Margin="0,4,0,0" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                                        <Border CornerRadius="1" Background="{StaticResource WTrack}"/>
                                        <Border CornerRadius="1" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Idle}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Background="Transparent" Cursor="Hand" Padding="3,2" MouseUp="OnMediaPrevious" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE892;" FontFamily="{StaticResource Glyphs}" FontSize="8" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                    <Border Background="Transparent" Cursor="Hand" Padding="4,2" MouseUp="OnMediaToggle" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                    <Border Background="Transparent" Cursor="Hand" Padding="3,2" MouseUp="OnMediaNext" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource Glyphs}" FontSize="8" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- Music, smaller: the same, with only play and pause. -->
        <DataTemplate x:Key="MusicPause">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Width="100" Background="{StaticResource WMusic}">
                        <Grid>
                            <Border CornerRadius="11" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Backdrop}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="11" Background="#99000000"/>
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="7" Background="{StaticResource WTrack}">
                                    <Grid>
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{StaticResource WInk}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="7" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WInk}"/>
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" FontSize="7.5" Margin="0,1,0,0"/>
                                    <Grid Height="2" Margin="0,4,0,0" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                                        <Border CornerRadius="1" Background="{StaticResource WTrack}"/>
                                        <Border CornerRadius="1" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Idle}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Background="Transparent" Cursor="Hand" Padding="3,2" MouseUp="OnMediaToggle" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <!-- Music with the cover stretched and blurred behind the title, the controls and the progress. -->
        <DataTemplate x:Key="MusicBackdrop">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WiderSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Width="154" Background="{StaticResource WMusic}">
                        <Grid>
                            <Border CornerRadius="11" Visibility="{Binding HasCover, Converter={StaticResource Show}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Backdrop}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="11" Background="#38000000"/>
                            <Grid Margin="10,5,10,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource WInk}"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Idle}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Background="Transparent" Cursor="Hand" Padding="6,2" MouseUp="OnMediaPrevious">
                                        <TextBlock Text="&#xE892;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                    <Border Background="Transparent" Cursor="Hand" Padding="10,2" MouseUp="OnMediaToggle">
                                        <TextBlock Text="{Binding ToggleGlyph}" FontFamily="{StaticResource Glyphs}" FontSize="12" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                    <Border Background="Transparent" Cursor="Hand" Padding="6,2" MouseUp="OnMediaNext">
                                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource Glyphs}" FontSize="10" Foreground="{StaticResource WInk}"/>
                                    </Border>
                                </StackPanel>
                                <Grid Grid.Row="2" Height="2" Visibility="{Binding HasProgress, Converter={StaticResource Show}}">
                                    <Border CornerRadius="1" Background="{StaticResource WTrack}"/>
                                    <Border CornerRadius="1" Background="{StaticResource WInk}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>
        <v:FaceSelector x:Key="Faces" Compact="{StaticResource CompactWidget}" MusicPause="{StaticResource MusicPause}"
                        MusicFull="{StaticResource MusicFull}" MusicBackdrop="{StaticResource MusicBackdrop}"/>

        <DataTemplate DataType="{x:Type vm:WeatherWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{StaticResource WWeather}">
                        <Grid Margin="9,6,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="19" Foreground="{StaticResource WInk}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Temp}" Style="{StaticResource Big}" FontSize="15"/>
                                <TextBlock Text="{Binding Condition}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Day}" Value="False">
                    <Setter TargetName="Face" Property="Background" Value="{StaticResource WWeatherNight}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Stale}" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MicWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Tip}">
                <Border x:Name="Face" CornerRadius="13" Background="{DynamicResource TileFace}"/>
                <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="19" Foreground="{DynamicResource DockInk}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="#E6E5483B"/>
                    <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Present}" Value="False">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NetworkWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{StaticResource WNetwork}">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓" Style="{StaticResource Caption}" FontSize="9" Foreground="{StaticResource WInk}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Down}" Style="{StaticResource Big}" FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="↑" Style="{StaticResource Caption}" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Up}" Style="{StaticResource Caption}" FontSize="8.5" Foreground="{StaticResource WInk}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NoteWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Text}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{StaticResource WNote}">
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource DockFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#3A2E12" Margin="9,5,9,5"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="11.5" VerticalAlignment="Center"/>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Empty}" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BatteryWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Width="46" Background="{StaticResource WBattery}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{StaticResource WInk}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" FontSize="8.5" Foreground="{StaticResource WInk}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>

        <ItemsControl x:Name="Strip" ItemsSource="{Binding Tiles}" Margin="0,0,0,6" Focusable="False" ItemTemplateSelector="{StaticResource Faces}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <v:LensPanel Loaded="OnPanelLoaded" MouseMove="OnPanelMove" MouseEnter="OnPanelEnter" MouseLeave="OnPanelLeave"
                                 MouseRightButtonUp="OnPanelMenu" MouseWheel="OnPanelWheel"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="v:LensPanel.Lens" Value="{Binding Lens}"/>
                    <Setter Property="v:LensPanel.Indicator" Value="{Binding Indicator}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="NameTag" CornerRadius="9" Padding="10,5" Opacity="0" Background="#EB1E2029"
                    BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock x:Name="NameText" FontSize="11.5" Foreground="#F4EFE7"/>
            </Border>
            <Border x:Name="Banner" CornerRadius="14" Padding="14,7" Opacity="0" BorderBrush="#40FFFFFF" BorderThickness="1">
                <TextBlock x:Name="BannerText" FontSize="12" FontWeight="Bold" Foreground="#101114"/>
            </Border>
        </Canvas>
        <Canvas>
            <Border x:Name="Toast" CornerRadius="11" Padding="12,5,6,5" Visibility="Collapsed" Background="#F21E2029" BorderBrush="#26FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" FontSize="11.5" Foreground="#F4EFE7" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="8" Background="#26FFFFFF" Cursor="Hand" MouseLeftButtonUp="OnUndo">
                        <TextBlock x:Name="UndoText" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFB547"/>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
