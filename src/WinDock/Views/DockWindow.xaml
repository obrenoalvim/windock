            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{DynamicResource WEpic}" BorderBrush="{DynamicResource WEpicEdge}">
                        <Grid Margin="8,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Logo}" Width="30" Height="30" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="Fallback" Text="&#xE7FC;" FontFamily="{StaticResource Glyphs}" FontSize="24" Foreground="{DynamicResource WEpicAccent}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource WGamesInk}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="Store" Text="{Binding Name}" Style="{StaticResource Caption}" FontSize="7.5" Foreground="{DynamicResource WEpicAccent}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSteam}" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource WSteam}"/>
                    <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource WSteamEdge}"/>
                    <Setter TargetName="Fallback" Property="Foreground" Value="{DynamicResource WSteamAccent}"/>
                    <Setter TargetName="Store" Property="Foreground" Value="{DynamicResource WSteamAccent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NetworkWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{DynamicResource WNetwork}">
                        <Grid Margin="10,8,10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓" Style="{StaticResource Caption}" FontSize="9" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Down}" Style="{StaticResource Big}" FontSize="10.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="↑" Style="{StaticResource Caption}" FontSize="9" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Up}" Style="{StaticResource Caption}" FontSize="8.5" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NoteWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Text}">
                <Viewbox>
                    <Border x:Name="Face" Style="{StaticResource WidgetFace}" Background="{DynamicResource WNote}">
                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource DockFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" Margin="9,5,9,5"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="11.5" VerticalAlignment="Center"/>
                    </Border>
                </Viewbox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Empty}" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BatteryWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource IconSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Width="46" Background="{DynamicResource WBattery}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="15" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" FontSize="8.5" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PeripheralsWidget}">
            <Grid Style="{StaticResource TileRoot}" Width="{DynamicResource WideSize}" ToolTip="{Binding Tip}">
                <Viewbox>
                    <Border Style="{StaticResource WidgetFace}" Background="{DynamicResource WPeripherals}">
                        <Grid Margin="9,5,9,5">
                            <TextBlock Text="{Binding Tip}" Style="{StaticResource Caption}" FontSize="8" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Visibility="{Binding Empty, Converter={StaticResource Show}}"/>
                            <ItemsControl ItemsSource="{Binding Top}" VerticalAlignment="Center" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Row" Height="11.5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Glyphs}" FontSize="9" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1" Height="4" Margin="2,0,4,0">
                                                <Border CornerRadius="2" Background="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}, ConverterParameter=track}"/>
                                                <Border x:Name="Fill" CornerRadius="2" Background="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Level}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="Value" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Caption}" Foreground="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Low}" Value="True">
                                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource WLow}"/>
                                                <Setter TargetName="Value" Property="Foreground" Value="{Binding (v:Surface.Brush), RelativeSource={RelativeSource Self}, Converter={StaticResource Ink}, ConverterParameter=alert}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Asleep}" Value="True">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Viewbox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Grid.RenderTransform>

        <ItemsControl x:Name="Strip" ItemsSource="{Binding Tiles}" Margin="0,0,0,6" Focusable="False" ItemTemplateSelector="{StaticResource Faces}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <v:LensPanel Loaded="OnPanelLoaded" MouseMove="OnPanelMove" MouseEnter="OnPanelEnter" MouseLeave="OnPanelLeave"
                                 MouseRightButtonUp="OnPanelMenu" MouseWheel="OnPanelWheel"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="v:LensPanel.Lens" Value="{Binding Lens}"/>
                    <Setter Property="v:LensPanel.Indicator" Value="{Binding Indicator}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <Canvas IsHitTestVisible="False">
            <Border x:Name="NameTag" CornerRadius="9" Padding="10,5" Opacity="0" Background="#EB1E2029"
                    BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock x:Name="NameText" FontSize="11.5" Foreground="#F4EFE7"/>
            </Border>
            <Border x:Name="Banner" CornerRadius="14" Padding="14,7" Opacity="0" BorderBrush="#40FFFFFF" BorderThickness="1">
                <TextBlock x:Name="BannerText" FontSize="12" FontWeight="Bold" Foreground="#101114"/>
            </Border>
        </Canvas>
        <Canvas>
            <Border x:Name="Toast" CornerRadius="11" Padding="12,5,6,5" Visibility="Collapsed" Background="#F21E2029" BorderBrush="#26FFFFFF" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToastText" FontSize="11.5" Foreground="#F4EFE7" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="9,3" CornerRadius="8" Background="#26FFFFFF" Cursor="Hand" MouseLeftButtonUp="OnUndo">
                        <TextBlock x:Name="UndoText" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFB547"/>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
