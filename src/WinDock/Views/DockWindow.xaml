<Window x:Class="WinDock.Views.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="30">
        <Border x:Name="Shell" CornerRadius="32" Background="{StaticResource ShellBrush}"
                BorderBrush="{StaticResource RimBrush}" BorderThickness="1" Padding="20,16,20,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShellShift"/>
            </Border.RenderTransform>

            <Grid>
                <Border CornerRadius="30" IsHitTestVisible="False" Background="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=Window}}"
                        Opacity="0.16" OpacityMask="{StaticResource AuraMask}" Margin="-20,-16,-20,-18"/>

                <StackPanel>
                    <DockPanel Margin="0,0,0,14" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="36,0,4,0">
                            <StackPanel Visibility="{Binding ShowNext, Converter={StaticResource Show}}" Margin="0,0,26,0" VerticalAlignment="Center">
                                <TextBlock Text="PRÓXIMO" FontFamily="{StaticResource Mono}" FontSize="8.5" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding NextText}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="11.5"
                                           Foreground="{StaticResource Ink}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowCpu, Converter={StaticResource Show}}" Margin="0,0,20,0" VerticalAlignment="Center">
                                <DockPanel Width="64">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="CPU" FontFamily="{StaticResource Mono}" FontSize="8.5" Foreground="{StaticResource Muted}"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Cpu}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowRam, Converter={StaticResource Show}}" Margin="0,0,24,0" VerticalAlignment="Center">
                                <DockPanel Width="64">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamText}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Ink}"/>
                                    <TextBlock Text="RAM" FontFamily="{StaticResource Mono}" FontSize="8.5" Foreground="{StaticResource Muted}"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource MeterBar}" Value="{Binding Ram}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowClock, Converter={StaticResource Show}}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Display}" FontSize="24" Foreground="{StaticResource Ink}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Date}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,4,2,0"/>
                            </StackPanel>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Presets}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>

                    <Rectangle Height="1" Fill="{StaticResource Hairline}" Margin="0,0,0,16"/>

                    <ItemsControl x:Name="Tiles" ItemsSource="{Binding Items}" HorizontalAlignment="Center" MinHeight="96">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TileButton}" Command="{Binding LaunchCommand}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Remover do dock" Command="{Binding RemoveCommand}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Solte um programa aqui para fixar neste ambiente" FontFamily="{StaticResource Mono}" FontSize="11"
                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,-70,0,36"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Show}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
