<Window x:Class="WinDock.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:WinDock.Services"
        Title="WinDock"
        Width="860" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <DataTemplate x:Key="PinTemplate">
                                                    <Border Width="52" Height="52" CornerRadius="15" Margin="0,0,8,8" Background="{StaticResource Plate}"
                                                            BorderBrush="{StaticResource Hairline}" BorderThickness="1" ToolTip="{Binding Tip}"
                                                            Opacity="{Binding Fade}">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{Binding [moveLeft], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding MoveLeftCommand}"/>
                                                                <MenuItem Header="{Binding [moveRight], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding MoveRightCommand}"/>
                                                                <MenuItem Header="{Binding [removeFromPreset], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Command="{Binding RemoveCommand}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Grid>
                                                            <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontSize="16"
                                                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
    </Window.Resources>

    <Grid Margin="26">
        <Border CornerRadius="30" Background="{StaticResource ShellBrush}"
                BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <Grid Margin="26,22,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <ToggleButton x:Name="EnvTab" Content="{Binding [tabEnvironments], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ChipToggle}"
                                  IsChecked="True" Click="OnEnvironmentsTab"/>
                    <ToggleButton x:Name="DockTab" Content="{Binding [tabDock], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ChipToggle}"
                                  Click="OnDockTab"/>
                </StackPanel>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderDrag" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="WINDOCK" FontFamily="{StaticResource Display}" FontSize="20" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding [subtitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                   Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <ToggleButton x:Name="EnChip" Content="EN" Style="{StaticResource ChipToggle}" Click="OnEnglish" ToolTip="English" Margin="0,0,0,0"/>
                        <ToggleButton x:Name="PtChip" Content="PT" Style="{StaticResource ChipToggle}" Click="OnPortuguese" ToolTip="Português" Margin="0,0,6,0"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" Click="OnClose" Padding="0" AutomationProperties.Name="{Binding [closeName], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" ToolTip="{Binding [close], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="DockPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0" Visibility="Collapsed">
                    <StackPanel DataContext="{Binding Dock}">
                        <Border Margin="0,0,0,12" Padding="18,16" CornerRadius="20" Background="{StaticResource Plate}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding [dockTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource Ink}" Margin="0,0,0,16"/>
                                <ToggleButton Content="{Binding [showDock], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,0,14"/>
                                <ToggleButton Content="{Binding [trayStartup], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,14"/>
                                <ToggleButton Content="{Binding [replaceTaskbar], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding ReplaceTaskbar, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding [replaceTaskbarDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource Note}"/>
                                <ToggleButton Content="{Binding [autoHide], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoHide, Mode=TwoWay}" Margin="0,0,0,14"/>
                                <ToggleButton Content="{Binding [reserve], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding Reserve, Mode=TwoWay}"
                                              IsEnabled="{Binding CanReserve}"/>
                                <TextBlock Text="{Binding [reserveDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource Note}"/>
                                <ToggleButton Content="{Binding [followWindows], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding FollowWindows, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding [followWindowsDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource Note}"/>
                                <ToggleButton Content="{Binding [syncTaskbar], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding SyncTaskbar, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding [syncTaskbarDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource Note}" Margin="43,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,12" Padding="18,16" CornerRadius="20" Background="{StaticResource Plate}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding [appearance], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource Ink}" Margin="0,0,0,16"/>

                                <TextBlock Text="{Binding [lens], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ToggleButton Content="{Binding [lensNone], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ChipToggle}" IsChecked="{Binding LensNone, Mode=TwoWay}"/>
                                    <ToggleButton Content="{Binding [lensScale], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ChipToggle}" IsChecked="{Binding LensScale, Mode=TwoWay}"/>
                                    <ToggleButton Content="{Binding [lensMagnify], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ChipToggle}" IsChecked="{Binding LensMagnify, Mode=TwoWay}"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [magnification], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1.1" Maximum="2.4" Value="{Binding Magnification, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Magnification, StringFormat={}{0:0.00}x}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [lensWidth], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="4.5" Value="{Binding LensWidth, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LensWidth, StringFormat={}{0:0.0}}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [iconSize], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="32" Maximum="72" Value="{Binding IconSize, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding IconSize, StringFormat={}{0:0} px}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding [theme], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ToggleButton Content="{Binding [compactWidgets], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding CompactWidgets, Mode=TwoWay}" Margin="0,0,0,14"/>
                                <ComboBox x:Name="ThemeBox" Style="{StaticResource FlatCombo}" Width="240" HorizontalAlignment="Left"
                                          SelectedValuePath="Id" SelectionChanged="OnThemePicked">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="26" Height="14" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center"
                                                        Background="{Binding Swatch}" BorderBrush="{Binding Rim}" BorderThickness="1.5"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <StackPanel x:Name="ScreenRow" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Text="{Binding [screen], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                    <StackPanel x:Name="Screens" Orientation="Horizontal"/>
                                    <ToggleButton Content="{Binding [perScreen], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding PerScreen, Mode=TwoWay}" Margin="0,14,0,0"/>
                                    <TextBlock Text="{Binding [perScreenDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource Note}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="EnvironmentsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <StackPanel>
                    <Border DataContext="{Binding Always}" Margin="0,0,0,12" Padding="18,16" CornerRadius="20"
                            Background="{StaticResource Plate}" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding [alwaysTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Display}" FontSize="12.5" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="{Binding [alwaysDesc], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource Muted}" Margin="0,8,0,14"/>
                            <ItemsControl ItemsSource="{Binding Pins}" ItemTemplate="{StaticResource PinTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Content="{Binding [addProgram], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                    Margin="0,2,0,0" Click="OnAddProgram"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="18,16" CornerRadius="20" Background="{StaticResource Plate}" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{Binding Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding [apply], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" FontWeight="Bold"
                                                        Background="{Binding Accent}" Foreground="#101114" Margin="0,0,8,0"
                                                        IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{Binding [useCurrent], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.UseCurrentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="{Binding [delete], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Click="OnDelete"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Glyph}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}"
                                                     FontFamily="{StaticResource Display}" FontSize="12.5" Width="200" HorizontalAlignment="Left"/>
                                            <Border CornerRadius="9" Padding="9,4" Margin="12,0,0,0" Background="{Binding Accent}" VerticalAlignment="Center"
                                                    HorizontalAlignment="Left" Visibility="{Binding IsActive, Converter={StaticResource Show}}">
                                                <TextBlock Text="{Binding [onTaskbar], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="9" Foreground="#101114"/>
                                            </Border>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"
                                                   Margin="2,16,0,10"/>

                                        <ItemsControl ItemsSource="{Binding Pins}" ItemTemplate="{StaticResource PinTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            
                                        </ItemsControl>

                                        <TextBlock Text="{Binding [emptyHint], Source={x:Static svc:Loc.Instance}, Mode=OneWay}"
                                                   FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                   Margin="2,0,0,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Content="{Binding [addProgram], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                                Margin="0,2,0,0" Click="OnAddProgram"/>

                                        <TextBlock Text="{Binding [schedule], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Muted}"
                                                   Margin="2,16,0,8"/>

                                        <ItemsControl ItemsSource="{Binding Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <ItemsControl ItemsSource="{Binding Days}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ToggleButton Style="{StaticResource DayToggle}" Content="{Binding Label}"
                                                                                  IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                                  Tag="{Binding DataContext.Accent, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding [from], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                                                        <TextBox Text="{Binding Start, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}" Width="62"/>
                                                        <TextBlock Text="{Binding [to], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                   VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                        <TextBox Text="{Binding End, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}" Width="62"/>
                                                        <Button Content="{Binding [remove], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="{Binding [addSlot], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Command="{Binding AddSlotCommand}" Margin="-6,2,0,0"/>

                                        <TextBlock Text="{Binding [widgets], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="9" Foreground="{StaticResource Muted}"
                                                   Margin="2,16,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Widgets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Content="{Binding Label}" Style="{StaticResource ChipToggle}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,0,6"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasCountdown, Converter={StaticResource Show}}">
                                            <TextBlock Text="{Binding [countdownDate], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox Text="{Binding CountdownDate, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}" Width="110"/>
                                            <TextBlock Text="{Binding [countdownLabel], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" Margin="14,0,8,0"/>
                                            <TextBox Text="{Binding CountdownLabel, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}" Width="170"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding [countdownHint], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"
                                                   Margin="2,6,0,0" Visibility="{Binding HasCountdown, Converter={StaticResource Show}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding HasWeather, Converter={StaticResource Show}}">
                                            <TextBlock Text="{Binding [weatherCity], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"
                                                       VerticalAlignment="Center" Margin="2,0,8,0"/>
                                            <TextBox Text="{Binding WeatherCity, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FlatBox}" Width="220"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding [weatherCityHint], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource Muted}"
                                                   Margin="2,6,0,0" TextWrapping="Wrap" Visibility="{Binding HasWeather, Converter={StaticResource Show}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Rectangle Height="1" Fill="{StaticResource Hairline}" Margin="0,0,0,16"/>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{Binding [restoreOriginal], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                    Command="{Binding RestoreOriginalCommand}"/>
                            <Button Content="{Binding [folder], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                    Command="{Binding OpenFolderCommand}"/>
                            <Button Content="{Binding [newPreset], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" Background="#FFB547" Foreground="#101114" FontWeight="Bold"
                                    Command="{Binding AddCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Content="{Binding [autoSwitch], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding AutoSwitch, Mode=TwoWay}"/>
                            <ToggleButton Content="{Binding [notifySwitch], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource SwitchToggle}" IsChecked="{Binding NotifySwitch, Mode=TwoWay}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="2,14,0,0">
                        <Run Text="{Binding NextText, Mode=OneWay}"/>
                        <Run Text="   ·   "/>
                        <Run Text="{Binding Status, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
