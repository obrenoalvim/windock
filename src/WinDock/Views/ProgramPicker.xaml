<Window x:Class="WinDock.Views.ProgramPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:WinDock.Services"
        Title="Add programs"
        Width="640" Height="740"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="26">
        <Border CornerRadius="28" Background="{StaticResource ShellBrush}"
                BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <Grid Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding [pickerTitle], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Display}" FontSize="15" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="{Binding [pickerSub], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"/>

                <TextBox x:Name="Search" Grid.Row="2" Style="{StaticResource FlatBox}" Margin="0,0,0,12"
                         TextChanged="OnSearch"/>

                <ListBox x:Name="List" Grid.Row="3" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnConfirm">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontFamily="{StaticResource Mono}" FontSize="9.5"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <Image Source="{Binding Icon}" Width="30" Height="30" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="4" Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding [cancel], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel"/>
                        <Button Content="{Binding [add], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" Background="#FFB547" Foreground="#101114"
                                FontWeight="Bold" Click="OnConfirm"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding [browse], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" Click="OnBrowse"/>
                        <Button Content="{Binding [browseFolder], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OnBrowseFolder"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

