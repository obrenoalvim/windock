<Window x:Class="WinDock.Views.ProgramPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar programas"
        Width="600" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="26">
        <Border CornerRadius="28" Background="{StaticResource ShellBrush}"
                BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="12" Direction="270" Opacity="0.6" Color="Black"/>
            </Border.Effect>

            <Grid Margin="24,22,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDrag" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADICIONAR PROGRAMAS" FontFamily="{StaticResource Display}" FontSize="15" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Escolha o que vai ficar fixo na taskbar." FontFamily="{StaticResource Mono}" FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="Search" Grid.Row="1" Style="{StaticResource FlatBox}" Margin="0,0,0,12"
                         TextChanged="OnSearch"/>

                <ListBox x:Name="List" Grid.Row="2" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnConfirm">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="3" Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancelar" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnCancel"/>
                        <Button Content="Adicionar" Style="{StaticResource ActionButton}" Background="#FFB547" Foreground="#101114"
                                FontWeight="Bold" Click="OnConfirm"/>
                    </StackPanel>
                    <Button Content="Procurar arquivo..." Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Click="OnBrowse"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
